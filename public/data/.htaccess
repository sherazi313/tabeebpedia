# Tabeeb Pedia - Direct Data Access Shield
# Deny all direct web browser access to JSON files in the data directory
# Only internal PHP scripts can read/write data files

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
