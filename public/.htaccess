# ==============================================================================
# TABEEB PEDIA - HOSTINGER HARDENED SECURITY & SERVER CONFIGURATION (.htaccess)
# ==============================================================================

# 1. DISABLE DIRECTORY BROWSING (ڈائریکٹری لسٹنگ کی مکمل بندش)
Options -Indexes -MultiViews

# 2. FORCE HTTPS & STRICT TRANSPORT SECURITY (زبردستی محفوظ HTTPS ری ڈائریکشن)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect HTTP to HTTPS
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://tabeebpedia.com/$1 [L,R=301]
</IfModule>

# 3. HTTP SECURITY HEADERS (جامع سیکیورٹی ہیڈرز)
<IfModule mod_headers.c>
    # Prevent Clickjacking (ویب سائٹ کو آئی فریم میں ہیکنگ سے بچاؤ)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-Type Sniffing (خطرناک فائلز کی غلط انٹرپریٹیشن روکنا)
    Header always set X-Content-Type-Options "nosniff"

    # Enable XSS Filter in supported browsers
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer Policy for Privacy Protection
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy (مائیکروفون، کیمرہ اور لوکیشن پر غیر ضروری پابندی)
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"

    # HSTS (HTTP Strict Transport Security - 1 Year)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Content Security Policy (Basic Protection)
    Header always set Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data: blob:; font-src 'self' https: data:; connect-src 'self' https:;"
</IfModule>

# 4. BLOCK ACCESS TO SENSITIVE SYSTEM FILES & CONFIGS (حساس سسٹم فائلوں تک رسائی بلاک)
<FilesMatch "\.(env|sql|log|ini|git|bak|config|json|xml|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Allow public sitemap and robots.txt
<FilesMatch "^(sitemap\.xml|robots\.txt)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Allow public data json files needed for client-side queries
<FilesMatch "^(articles|categories|doctors|glossary|pages|settings|herbsCalculatorData|pdf-books)\.json$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# 5. SPA ROUTING - FORWARD TO INDEX.HTML FOR REACT (سنگل پیج ایپلی کیشن روٹنگ)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass API requests directly to PHP files
    RewriteRule ^api/(.*)$ api/$1 [L,QSA]

    # If the requested file or directory exists, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise route everything to index.html
    RewriteRule ^ index.html [L]
</IfModule>

# 6. GZIP & BROTLI COMPRESSION (تیز رفتار پرفارمنس)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
